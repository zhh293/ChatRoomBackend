# 复制为 .env 并由密钥管理系统注入真实值。不要提交 .env。
COMPOSE_PROJECT_NAME=chatroom-production

# 每台应用主机必须唯一，用于 Redis 在线状态和跨节点推送路由。
MACHINE_ID=chatroom-prod-node-01
DOMAIN=chat.example.com
CHATROOM_IMAGE=registry.example.com/chatroom-backend:1.0.0

SPRING_PROFILES_ACTIVE=prod
DB_URL=jdbc:mysql://mysql-primary.internal:3306/chatroom?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai&useSSL=true
DB_USERNAME=chatroom
DB_PASSWORD=replace-with-secret

REDIS_HOST=redis-primary.internal
REDIS_PORT=6379
REDIS_PASSWORD=replace-with-secret

RABBITMQ_HOST=rabbitmq.internal
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=chatroom
RABBITMQ_PASSWORD=replace-with-secret

JWT_SECRET=replace-with-at-least-32-random-bytes

XXL_JOB_ADMIN_ADDRESSES=https://xxl-job.internal/xxl-job-admin
XXL_JOB_ACCESS_TOKEN=replace-with-secret
XXL_JOB_EXECUTOR_PORT=9999

# 当前代码尚未接入真实 OSS 实现；完成接入后填写 CDN/OSS 公网前缀。
OSS_ENDPOINT=https://oss.internal
OSS_BUCKET=chatroom
OSS_ACCESS_KEY=replace-with-secret
OSS_SECRET_KEY=replace-with-secret
OSS_URL_PREFIX=https://cdn.example.com/chatroom

JAVA_OPTS=-Xms1g -Xmx1g -XX:+UseG1GC -XX:+ExitOnOutOfMemoryError -Dfile.encoding=UTF-8

# 线程池与群聊阈值，可按压测结果调整。
THREAD_POOL_MSG_PERSIST_CORE_SIZE=10
THREAD_POOL_MSG_PERSIST_MAX_SIZE=50
THREAD_POOL_MSG_PERSIST_QUEUE_CAPACITY=1000
CHAT_GROUP_WRITE_FANOUT_THRESHOLD=1000
CHAT_GROUP_MAX_MEMBER_COUNT=2000
