# 复制为 .env 后修改。该文件不要提交到 Git。
COMPOSE_PROJECT_NAME=chatroom-personal

# 统一访问入口：http://localhost:8080
APP_PORT=8080
PUBLIC_BASE_URL=http://localhost:8080

# 中间件端口仅绑定到 127.0.0.1，按需修改以避免冲突。
MYSQL_PORT=3306
REDIS_PORT=6379
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672

# 首次启动后不要随意修改持久化服务密码。
MYSQL_ROOT_PASSWORD=replace-with-root-password
MYSQL_DATABASE=chatroom
MYSQL_USER=chatroom
MYSQL_PASSWORD=replace-with-db-password

REDIS_PASSWORD=replace-with-redis-password

RABBITMQ_USERNAME=chatroom
RABBITMQ_PASSWORD=replace-with-rabbitmq-password

# 至少 32 字节的随机字符串。示例：openssl rand -base64 48
JWT_SECRET=replace-with-at-least-32-random-bytes

# 个人部署默认不启动 XXL-Job Admin，留空即可。
XXL_JOB_ADMIN_ADDRESSES=
XXL_JOB_ACCESS_TOKEN=replace-with-xxl-job-token

# JVM 参数可按机器内存调整。
JAVA_OPTS=-Xms256m -Xmx768m -XX:+ExitOnOutOfMemoryError -Dfile.encoding=UTF-8
